QWidget { font-family: 'Segoe UI Variable', 'Segoe UI', sans-serif; font-size: 13px; }
QMainWindow { border: 1px solid #ceced6; border-radius: 12px; }
QMenuBar::item { padding: 8px 9px; border-radius: 6px; }
QMenuBar::item:selected { background: #d9d9e2; }
QMenu { background: #f6f6f8; border: none; border-radius: 10px; padding: 6px; }
QMenu::item { border-radius: 5px; padding: 7px 28px 7px 12px; }
QMenu::item:selected { background: #3478f6; color: white; }
QMenu::item:disabled { color: #9a9aa5; }
QPushButton { background: #ffffff; border: 1px solid #d4d4dc; border-radius: 6px; font-size: 13px; }
QPushButton:hover { background: #eeeeF2; }
QToolButton#quickSlot { border-radius: 7px; padding: 3px; }
QToolButton#quickSlot:hover { background: #d9d9e2; }
QLineEdit, QSpinBox, QComboBox, QListWidget, QTextEdit { background: #ffffff; color: #26262b; border: 1px solid #d4d4dc; border-radius: 6px; padding: 5px; }
QScrollBar { background: transparent; }
QScrollBar::handle { background: #b6b6c2; }
